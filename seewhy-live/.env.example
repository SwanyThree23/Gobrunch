# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/seewhy_live
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seewhy_live
DB_USER=postgres
DB_PASSWORD=password

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# File Upload
MAX_VIDEO_SIZE_MB=500
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173
