# SeeWhy LIVE - Environment Variables
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key

# Stripe Payments (Platform)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly

# Stripe Connect (Creator Payouts)
# Platform fee percentage charged on direct charges (tips, tickets)
STRIPE_PLATFORM_FEE_PERCENT=15

# Database
DATABASE_URL="file:./dev.db"

# WebSocket (optional - for production)
# WS_URL=wss://your-websocket-server.com

# VDO.Ninja (optional - auto-configured per room)
# VDO_NINJA_API_KEY=your-vdo-ninja-api-key
