# SeeWhy LIVE v3.0 Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API key — get yours at https://openrouter.ai/keys
VITE_OPENROUTER_KEY=

# Supabase — get project URL and anon key at https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mux — get credentials at https://dashboard.mux.com
VITE_MUX_TOKEN_ID=
VITE_MUX_TOKEN_SECRET=
# Note: Mux stream key creation requires server-side (backend) calls.
# Use Mux Data Environment Key for client-side stream monitoring.
VITE_MUX_ENV_KEY=
