# SeeWhy LIVE / SwanyThree Ultimate - Environment Variables
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production

# OpenRouter AI (AI Tools Wrapper Pro)
OPENROUTER_API_KEY=your-openrouter-api-key

# Stripe Payments (Platform)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly

# Stripe Connect (Creator Payouts - 90/10 Split)
# Platform fee percentage charged on direct charges (tips, tickets, paywall)
STRIPE_PLATFORM_FEE_PERCENT=10

# Database
DATABASE_URL="file:./dev.db"

# Redis (Watch Party Sync, Session State)
REDIS_URL=redis://localhost:6379

# WebSocket
WS_PORT=3001
# WS_URL=wss://your-websocket-server.com

# VDO.Ninja (auto-configured per room)
# VDO_NINJA_API_KEY=your-vdo-ninja-api-key

# Vault Pro (AES-256-GCM Encryption)
VAULT_MASTER_KEY=your-vault-master-key-change-in-production-64-chars-min

# Google Translate API (Multilingual Chat)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Internal Secret (WebSocket -> API communication)
INTERNAL_SECRET=your-internal-ws-secret

# FFmpeg Worker Config
WORKER_MAX_STREAMS=25
